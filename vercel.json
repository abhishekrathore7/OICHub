{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "oic-hub-ten.vercel.app"
        }
      ],
      "destination": "https://oicinterviewquestions.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/oic-interview-questions",
      "destination": "/"
    },
    {
      "source": "/vbcs-interview-questions",
      "destination": "/"
    }
  ]
}